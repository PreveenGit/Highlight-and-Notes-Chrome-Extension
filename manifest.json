{
  "manifest_version": 3,
  "name": "Highlight",
  "version": "1.0.0",
  "description": "Highlight words and sentences on any web page. Highlights are saved per page and restored when you come back.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Highlight",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/common.js",
        "content/anchor.js",
        "content/marker.js",
        "content/store.js",
        "content/toolbar.js",
        "content/main.js"
      ],
      "css": ["content/highlight.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "highlight-selection": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Highlight the selected text"
    }
  }
}
